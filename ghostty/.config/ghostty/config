# Start zellij instead of a bare shell.
# Each new Ghostty window/tab gets its own zellij session.
# zellij spawns $SHELL (zsh) inside, so .zshrc still runs.
command = /home/fugufish/.cargo/bin/zellij

# Inherit the cwd from the surrounding window when opening new ones.
working-directory = inherit

# WSLg's compositor does not implement the Wayland primary-selection protocol
# (wl-copy --primary fails with "The compositor does not seem to support
# primary selection"). Ghostty's default `copy-on-select = true` prefers that
# selection clipboard, so a mouse selection here lands nowhere and Ctrl+V on
# the Windows side pastes stale text. `clipboard` writes the system clipboard
# too, which WSLg does mirror to Windows.
copy-on-select = clipboard

# Same reason: there is no primary selection to paste from, so make the
# default Shift+Insert binding use the system clipboard instead.
keybind = shift+insert=paste_from_clipboard

# Ctrl+click on a URL makes Ghostty exec `xdg-open`, which does not exist in
# WSL. ~/.local/bin/xdg-open forwards the target to explorer.exe so it opens in
# the Windows default browser; it must be symlinked onto Ghostty's own PATH
# (/usr/local/bin) because Ghostty is launched by WSLg, not by the shell.
#
# zellij turns on mouse reporting, so it swallows the click before Ghostty sees
# it. This toggles reporting off/on when a link needs clicking.
keybind = ctrl+shift+m=toggle_mouse_reporting
